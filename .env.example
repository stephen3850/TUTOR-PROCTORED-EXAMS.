# TUTOR PROCTORED EXAMS - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.

# Public Site Domain (Configurable production domain)
NEXT_PUBLIC_SITE_URL=https://tutorproctoredexams.com

# Public WhatsApp Contact Number (Digits only with country code, e.g. 254711882470)
NEXT_PUBLIC_WHATSAPP_NUMBER=254711882470

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Server-Side Email API Key (e.g. Resend, SendGrid) - NEVER prefix with NEXT_PUBLIC_
EMAIL_API_KEY=your_server_side_email_api_key_here
